data/magellan-hubspot-ids.json
# Live monitoring state — which campaign is being watched and when its next
# auto-check is due. Per-operator runtime state that was tracked by accident:
# every pull overwrote the puller's file with the committer's laptop, so an
# operator could rehydrate a monitoring schedule that was never theirs.
# The app treats an absent file as "nothing monitoring" (readMonitoringState
# returns null, clearMonitoringState deletes it routinely), so untracked is the
# state it is already designed for.
data/monitoring-campaign.json
data/monitoring-campaign.local-backup.json

# Vendored local dev engine — source is tracked, its dependencies are not.
engine/node_modules/
engine/data/
engine/.env
