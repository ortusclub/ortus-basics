# Copy this to 02-secret.yaml (gitignored), fill in real values, then apply.
#
# Two secrets:
#   1. GOOGLE_SERVICE_ACCOUNT_JSON — the full contents of your
#      service-account.json file, INCLUDING the outer braces { ... }.
#   2. APP_PASSWORD — the login password for the web UI.
#
# Easiest way to create from local files:
#
#   kubectl -n salesnav-scraper create secret generic salesnav-secrets \
#     --from-file=GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json \
#     --from-literal=APP_PASSWORD='your-strong-password'
#
# The YAML below is provided for reference / GitOps workflows.
apiVersion: v1
kind: Secret
metadata:
  name: salesnav-secrets
  namespace: salesnav-scraper
type: Opaque
stringData:
  APP_PASSWORD: "REPLACE_ME"
  GOOGLE_SERVICE_ACCOUNT_JSON: |
    {
      "type": "service_account",
      "project_id": "REPLACE_ME",
      "private_key_id": "REPLACE_ME",
      "private_key": "REPLACE_ME",
      "client_email": "REPLACE_ME",
      "client_id": "REPLACE_ME",
      "auth_uri": "https://accounts.google.com/o/oauth2/auth",
      "token_uri": "https://oauth2.googleapis.com/token",
      "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
      "client_x509_cert_url": "REPLACE_ME",
      "universe_domain": "googleapis.com"
    }
