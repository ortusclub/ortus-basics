# App password — used to log into the standalone web UI (scraper.ortusclub.com).
APP_PASSWORD=changeme

# Optional: dedicated bearer token the Ortus app sends to the engine. Defaults
# to APP_PASSWORD if unset. Set this to keep the app's service token separate
# from the human web-login password.
# ENGINE_SHARED_TOKEN=

# GoLogin API token (company-wide). The scraper drives the team's existing
# GoLogin profiles via the SDK — no noVNC login. The profile's LinkedIn session
# (which must have a Sales Navigator seat) comes from GoLogin's cloud-synced
# cookies. Launched LOCALLY on this host/pod (not cloud-run), so it is not
# subject to the GoLogin plan's 2-concurrent cloud-launch cap.
GOLOGIN_API_TOKEN=

# Google Sheets API — choose ONE method:
#   Option A: path to a service account JSON file (default: ./service-account.json)
#   Option B: paste the full JSON inline (this is how GKE injects it via the Secret)
# GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...",...}

# Port for the web server (the container / GKE sets this).
PORT=3000

# Slow mode: longer delays between pages (true = 6-10s, false = 2-4s).
SLOW_MODE=false

# Where the GoLogin SDK downloads the Orbita browser (set in the container image).
# GOLOGIN_HOME=/app/.gologin
